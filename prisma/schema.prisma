// AapKaPlot — initial schema. PostGIS extension is enabled so we can run
// ST_DistanceSphere queries for nearby search; the Prisma client uses
// Unsupported("geography") for the geo column and we read/write it through
// raw SQL helpers in /server/property/geo.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  BUYER
  SELLER
  AGENT
  ADMIN
  SUPER_ADMIN
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String?
  action      String   // e.g. "property.approve", "user.suspend", "user.delete"
  targetType  String   // "property" | "user"
  targetId    String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

model PerformanceScan {
  id              String   @id @default(cuid())
  url             String
  strategy        String   // "mobile" | "desktop"
  performance     Int?     // 0–100
  accessibility   Int?
  bestPractices   Int?
  seo             Int?
  lcpMs           Int?     // Largest Contentful Paint
  clsX1000        Int?     // CLS × 1000 (Prisma int)
  inpMs           Int?     // Interaction to Next Paint
  ttfbMs          Int?
  fcpMs           Int?
  raw             Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([strategy, createdAt])
}

enum PropertyKind {
  PLOT
  FLAT
  HOUSE
  VILLA
  SHOP
  OFFICE
  WAREHOUSE
  AGRICULTURE
}

enum ListingIntent {
  BUY
  RENT
  SELL
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  email        String?   @unique
  name         String?
  address      String?
  /// Optional separate WhatsApp number — sellers often use a different
  /// phone for WhatsApp business. When unset, the primary phone is used.
  whatsappPhone String?
  role         UserRole  @default(BUYER)
  suspended    Boolean   @default(false)
  passwordHash String?
  phoneVerified DateTime?
  emailVerified DateTime?
  aadhaarVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  properties   Property[]   @relation("OwnerProperties")
  favorites    Favorite[]
  leadsSent    Lead[]       @relation("LeadFromUser")
  leadsReceived Lead[]      @relation("LeadToUser")
  otpCodes     OtpCode[]
  payments     Payment[]
  visits       VisitRequest[]
  savedSearches SavedSearch[]
  verifications Verification[]
  reviewsWritten Review[]   @relation("ReviewAuthor")
  reviewsReceived Review[]  @relation("ReviewSubject")
  pushSubscriptions PushSubscription[]
  brokerProfile     BrokerProfile?
  brokerReferrals   BrokerReferral[] @relation("BrokerOfReferral")
  buyerReferrals    BrokerReferral[] @relation("BuyerOfReferral")
  commissionsEarned Commission[]
}

// Append to Property model — price history relation.

model Property {
  id           String         @id @default(cuid())
  title        String
  description  String?
  kind         PropertyKind
  intent       ListingIntent
  status       ListingStatus  @default(PENDING_REVIEW)

  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  priceInr     Int
  previousPriceInr Int?
  areaSqft     Int
  bhk          Int?

  locality     String
  city         String
  state        String
  pincode      String?

  lat          Float
  lng          Float
  /// PostGIS geography point. Populated via trigger or raw SQL update.
  geom         Unsupported("geography(Point,4326)")?
  /// Optional plot/compound polygon as a GeoJSON ring (array of [lng, lat] pairs).
  /// Stored as JSONB so simple admin/UI inspection stays cheap; PostGIS-side
  /// geography column can be added later when boundary-based search lands.
  boundary     Json?

  coverUrl     String
  gallery      String[]
  videoUrl     String?
  youtubeUrl   String?
  tourUrl      String?      // Matterport / Kuula / Roundme embed URL
  panoFrames   String[]     // optional 360° frame sequence
  satelliteUrl String?

  verified     Boolean  @default(false)
  trustScore   Int      @default(0)
  amenities    String[]
  aiBadges     String[]
  /// Frontage road widths in feet. Critical for Indian plot listings —
  /// affects pricing, Vastu, and vehicle access. All four sides optional;
  /// 0 / null means "no road on this side".
  roadEastFt   Int?
  roadWestFt   Int?
  roadNorthFt  Int?
  roadSouthFt  Int?

  featuredUntil DateTime?
  boostedUntil  DateTime?
  allowsBrokers Boolean  @default(false)
  brokerCommissionPct Float?  // optional per-listing override; null → use broker's default

  ownerId      String
  owner        User     @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  favorites    Favorite[]
  leads        Lead[]
  payments     Payment[]
  visits       VisitRequest[]
  reviews      Review[]
  referrals    BrokerReferral[]
  priceHistory PriceHistory[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city, state])
  @@index([kind, intent])
  @@index([priceInr])
  @@index([featuredUntil])
  /// Spatial index added in a migration:
  /// CREATE INDEX property_geom_idx ON "Property" USING GIST (geom);
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String?
  plan        String   // e.g. "boost-7d", "feature-30d"
  amountInr   Int
  provider    String   @default("manual")  // online payments paused; set per-provider when re-enabled
  orderId     String   @unique
  paymentId   String   @unique
  signature   String
  status      String   @default("paid") // "paid" | "failed" | "refunded"
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([propertyId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Lead {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String
  propertyId      String
  message         String?
  via             String?
  offerAmountInr  Int?
  offerStatus     String?  // pending | accepted | declined | countered | withdrawn
  status          String   @default("new") // new | contacted | qualified | lost
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromUser    User     @relation("LeadFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("LeadToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([fromUserId, toUserId, propertyId])
  @@index([toUserId, createdAt])
  @@index([status, createdAt])
}

model Message {
  id          String   @id @default(cuid())
  leadId      String
  fromUserId  String
  body        String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model VisitRequest {
  id           String   @id @default(cuid())
  propertyId   String
  userId       String?
  name         String
  phone        String
  slot         String
  scheduledFor DateTime
  status       String   @default("pending") // pending | confirmed | completed | cancelled
  note         String?
  createdAt    DateTime @default(now())

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([propertyId])
  @@index([status, scheduledFor])
}

model SavedSearch {
  id           String   @id @default(cuid())
  userId       String
  label        String
  /// Free-form filter object: { intent, kind, city, budgetMin, budgetMax, bhk, radiusKm, origin: {lat,lng}, amenities[] }
  query        Json
  frequency    String   @default("daily") // instant | daily | weekly
  lastSentAt   DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([active, frequency])
}

model Verification {
  id               String   @id @default(cuid())
  userId           String
  aadhaarFrontUrl  String
  aadhaarBackUrl   String?
  selfieUrl        String?
  panUrl           String?
  titleDocUrl      String?
  status           String   @default("pending") // pending | approved | rejected
  note             String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  propertyId   String?
  authorId     String
  subjectId    String?  // optional: review of a seller/agent profile
  rating       Int      // 1..5
  body         String
  createdAt    DateTime @default(now())

  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author       User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject      User?     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([propertyId, authorId])
  @@index([propertyId, createdAt])
  @@index([subjectId, createdAt])
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  builder         String
  description     String?
  city            String
  locality        String
  state           String
  pincode         String?
  lat             Float
  lng             Float
  startDate       DateTime?
  possessionDate  DateTime?
  totalUnits      Int?
  reraId          String?
  amenities       String[]
  coverUrl        String
  gallery         String[]
  status          String   @default("ongoing") // ongoing | upcoming | completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties      Property[]

  @@index([city, locality])
  @@index([status, createdAt])
}

model LocalityInsight {
  id            String   @id @default(cuid())
  cityKey       String   // lower-cased city
  localityKey   String   // lower-cased locality
  lat           Float
  lng           Float
  /// Free-form JSON: { amenities: {schools, hospitals, metro, malls, banks}, demographics?, lastSource: "overpass" }
  data          Json
  fetchedAt     DateTime @default(now())

  @@unique([cityKey, localityKey])
  @@index([fetchedAt])
}

model BrokerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  agencyName      String
  panNumber       String?
  reraNumber      String?
  reraVerified    Boolean  @default(false)
  city            String
  state           String
  bio             String?
  avatarUrl       String?
  /// Default commission % the broker charges when a listing has no override.
  defaultCommissionPct Float  @default(1.0)
  payoutMethod    String?  // "upi" | "bank"
  payoutDetails   Json?    // { upi?: string, accountNumber?, ifsc?, holderName? }
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, active])
  @@index([reraVerified])
}

model BrokerReferral {
  id                   String   @id @default(cuid())
  brokerId             String   // BrokerProfile.userId (FK to User for simplicity)
  buyerId              String
  propertyId           String
  leadId               String?  // links to the Lead row created in chat/offer flow
  commissionPct        Float
  /// Expected commission = property.priceInr * commissionPct / 100, snapshotted at refer time.
  expectedCommissionInr Int
  status               String   @default("pending") // pending | offer_accepted | closed | lost | expired
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  broker     User     @relation("BrokerOfReferral", fields: [brokerId], references: [id], onDelete: Cascade)
  buyer      User     @relation("BuyerOfReferral",  fields: [buyerId],  references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@unique([brokerId, buyerId, propertyId])
  @@index([brokerId, status, createdAt])
  @@index([propertyId])
}

model Commission {
  id          String   @id @default(cuid())
  brokerId    String
  referralId  String
  amountInr   Int
  status      String   @default("pending") // pending | approved | paid | cancelled
  note        String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  broker      User           @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  referral    BrokerReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([brokerId, status, createdAt])
}

model PushSubscription {
  id            String   @id @default(cuid())
  userId        String?
  endpoint      String   @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Live visitor tracking — one row per browser session, updated on every
/// page hit by the client-side beacon at /api/track/visit. The admin
/// /admin/visitors page reads from here.
model Visit {
  id            String    @id @default(cuid())
  /// Anonymous session token kept in localStorage / sessionStorage.
  sessionId     String    @unique
  userId        String?
  /// Cached at first beacon so the table renders fast without joining User.
  userName      String?
  userEmail     String?
  ip            String?
  country       String?
  region        String?
  city          String?
  district      String?
  postalCode    String?
  lat           Float?
  lng           Float?
  userAgent     String?
  referrer      String?
  /// CSV-ish list of property IDs the visitor opened during the session.
  propertiesViewed String[]
  /// Last URL the beacon reported.
  lastPath      String?
  pageviews     Int       @default(1)
  landedAt      DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  @@index([landedAt])
  @@index([lastSeenAt])
  @@index([country])
  @@index([userId])
}

/// Per-property price change history. Server records a row every time
/// Property.priceInr changes via /api/seller/property/[id] PATCH or
/// /api/admin/properties/[id] PATCH. The property page renders this as
/// a simple time-series chart so buyers can see negotiation room.
model PriceHistory {
  id          String   @id @default(cuid())
  propertyId  String
  priceInr    Int
  changedBy   String?  // userId who triggered the change
  reason      String?  // optional note ("price drop", "seller edit", ...)
  recordedAt  DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, recordedAt])
}

model OtpCode {
  id         String   @id @default(cuid())
  userId     String?
  channel    String   // "phone" | "email"
  identifier String   // phone or email used
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, channel, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Programmatic SEO — see lib/seo/* for generators & gates.
// One row per indexable city × locality × kind × intent page.
// ─────────────────────────────────────────────────────────────

enum SeoTemplate {
  OVERVIEW_MAP
  BUYING_GUIDE
  PRICE_DASHBOARD
  COMPARISON
  INVESTMENT_OUTLOOK
  KNOWLEDGE_FAQ
}

enum SeoStatus {
  PENDING
  PUBLISHED
  REJECTED      // Failed quality gate; kept for diagnostics
  ARCHIVED      // Page de-indexed deliberately
}

model SeoPage {
  id              String      @id @default(cuid())

  /// Stable URL slug. Format: "{intent}-{kind}/{geo-slug}" e.g. "buy-plot/boring-road"
  slug            String      @unique

  intent          String      // "buy" | "rent"
  kind            String      // PropertyKind slug (plot/flat/...) — denormalised for indexing
  geoSlug         String      // matches geo-dataset.ts GeoEntry.slug
  parentGeoSlug   String?     // parent city when geo is a locality

  template        SeoTemplate
  status          SeoStatus   @default(PENDING)

  title           String
  metaDescription String      @db.Text
  h1              String

  /// Full ComposedPage payload (blocks, paragraphs, data, sources, keywords)
  content         Json

  qualityScore    Int         // 0–100; ≥70 required to publish
  wordCount       Int
  sources         String[]    // ["aapkaplot-listings","wikipedia","openstreetmap"]
  keywords        String[]

  lastBuiltAt     DateTime    @default(now())
  lastIndexedAt   DateTime?   // when IndexNow ping succeeded
  publishedAt     DateTime?

  /// Google Search Console performance snapshot (28-day rolling).
  /// Populated by /api/admin/seo/gsc-sync when GSC_REFRESH_TOKEN is set.
  gscClicks       Int?
  gscImpressions  Int?
  gscCtr          Float?     // 0..1
  gscPosition     Float?     // average position; lower is better
  gscViews        Int?       // app-side analytics fallback
  lastGscSyncAt   DateTime?

  /// Slug-audit flags raised by lib/seo/audit.ts — e.g. "TRIPLE_TOKEN",
  /// "YEAR_STACK", "JUNK_FRAGMENT". Empty = clean.
  qualityFlags    String[]   @default([])

  @@index([status, publishedAt])
  @@index([geoSlug])
  @@index([template])
  @@index([lastBuiltAt])
  @@index([qualityScore])
  @@index([gscPosition])
}

