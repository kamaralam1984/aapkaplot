# ─────────────────────────────────────────────────────────────
# AapKaPlot — environment template. Copy to `.env` and fill in.
# Everything below is OPTIONAL. The app boots with a working
# mock catalogue + OTP auth if these are blank.
# ─────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Database (set USE_DB=1 to switch from mock catalogue) ──
USE_DB=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aapkaplot?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────
# Generate fresh secrets:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SECRET=change-me-too
NEXTAUTH_SECRET=change-me-too
NEXTAUTH_URL=http://localhost:3001
BCRYPT_ROUNDS=12

# Twilio (real SMS OTP). Blank → OTP code logged to console.
OTP_TWILIO_SID=
OTP_TWILIO_TOKEN=
OTP_TWILIO_FROM=

# ── OAuth — Google ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AapKaPlot <noreply@8rupiya.in>"
RESEND_API_KEY=

# ── Payments — Razorpay (use rzp_test_* for development) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI for /api/ai/describe ────────────────────────────────
# Empty ANTHROPIC_API_KEY → free Cloudflare Workers AI is used.
ANTHROPIC_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── AI failover keys (other features) ──────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

# ── Audio transcription ────────────────────────────────────
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── External data ──────────────────────────────────────────
SERPAPI_KEY=
RAPIDAPI_KEY=
YOUTUBE_API_KEY=

# ── SEO / Analytics ────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
PAGESPEED_API_KEY=
INDEXNOW_KEY=

# ── Google Search Console ──────────────────────────────────
GSC_SITE_URL=sc-domain:8rupiya.in
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# ── Cron jobs ──────────────────────────────────────────────
CRON_SECRET=

# ── Auto-deploy webhook (must match VPS .env.local) ────────
DEPLOY_WEBHOOK_TOKEN=
