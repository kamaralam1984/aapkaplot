# ─────────────────────────────────────────────────────────────
# AapKaPlot — environment template. Copy to `.env` and fill in.
# Everything below is OPTIONAL. The app boots with a working
# mock catalogue + OTP auth if these are blank.
# ─────────────────────────────────────────────────────────────

# Public site URL — used in canonical tags, OpenGraph, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Maps ────────────────────────────────────────────────────
# Free Mapbox token enables the interactive GL map. Without it
# the app falls back to a CSS map illustration.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Database (Step 1) ──────────────────────────────────────
# Flip USE_DB=1 to route data reads through Prisma instead of the
# in-memory mock catalogue. Run `npm run db:up && npm run db:push
# && npm run db:seed` first.
USE_DB=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aapkaplot?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────
# Used to sign the OTP session cookie. Generate a long random
# string for production:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
AUTH_SECRET=change-me-too

# Twilio (real SMS OTP). Without these, OTP code is logged to console.
OTP_TWILIO_SID=
OTP_TWILIO_TOKEN=
OTP_TWILIO_FROM=

# OAuth providers (Step 5). Set any one set and the Google/Apple
# buttons on /auth/login start working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Payments (Step 5) ──────────────────────────────────────
# Razorpay test keys enable real /api/payments/order responses.
# Without them, /checkout simulates the flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI (Step 3) ────────────────────────────────────────────
# When ANTHROPIC_API_KEY is set, /api/ai/describe generates
# listing copy with Claude. Otherwise the template bank is used.
ANTHROPIC_API_KEY=

# ── Storage ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
