# ─────────────────────────────────────────────────────────────
# AapKaPlot — environment template. Copy to `.env` and fill in.
# Everything below is OPTIONAL. The app boots with a working
# mock catalogue + OTP auth if these are blank.
# ─────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Database (set USE_DB=1 to switch from mock catalogue) ──
USE_DB=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aapkaplot?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────
# Generate fresh secrets:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SECRET=change-me-too
NEXTAUTH_SECRET=change-me-too
NEXTAUTH_URL=http://localhost:3001
BCRYPT_ROUNDS=12

# ── Admin allowlist ────────────────────────────────────────
# Comma-separated emails that get auto-promoted to SUPER_ADMIN on first
# sign-in. Anyone in this list can access /admin/* and the /api/admin/* APIs.
SUPER_ADMIN_EMAILS=

# Twilio (real SMS OTP). Blank → OTP code logged to console.
OTP_TWILIO_SID=
OTP_TWILIO_TOKEN=
OTP_TWILIO_FROM=

# ── OAuth — Google ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AapKaPlot <noreply@aapkaplot.com>"
RESEND_API_KEY=

# ── Image hosting (free) ──────────────────────────────────
# Get a free API key at https://api.imgbb.com/  →  blank falls back to
# saving uploads under /public/uploads/<uid>/.
IMGBB_API_KEY=

# ── Error tracking (free — GlitchTip self-host) ───────────
# Spin up GlitchTip via deploy/glitchtip.docker-compose.yml.
# Get the DSN from your GlitchTip project settings page.
# Empty = errors only logged to server console.
SENTRY_DSN=
NEXT_PUBLIC_RELEASE=dev

# ── Web push notifications (free, VAPID) ──────────────────
# Generate once:  npx web-push generate-vapid-keys
# Both blank → push opt-in button is hidden in the UI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@aapkaplot.com

# ── Payments — Razorpay (builder subscriptions + site-visit charges) ────
# Get keys from https://dashboard.razorpay.com → Settings → API Keys
# Test mode: use rzp_test_* keys. Live: rzp_live_* keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Public key exposed to frontend for Razorpay checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── AI for /api/ai/describe ────────────────────────────────
# Empty ANTHROPIC_API_KEY → free Cloudflare Workers AI is used.
ANTHROPIC_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── AI failover keys (other features) ──────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=

# ── Audio transcription ────────────────────────────────────
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── External data ──────────────────────────────────────────
SERPAPI_KEY=
RAPIDAPI_KEY=
YOUTUBE_API_KEY=

# YouTube channel feed (free, no API key — uses public RSS).
# Leave blank to use the AapKaPlot default channel.
YOUTUBE_CHANNEL_ID=UCFFYOHviTmLTgFgME-Ft0PQ

# ── SEO / Analytics ────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
PAGESPEED_API_KEY=
INDEXNOW_KEY=

# ── Google Search Console ──────────────────────────────────
GSC_SITE_URL=sc-domain:aapkaplot.com
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# ── Google site verification (HTML tag method) ─────────────
# Paste the "content" value from the meta tag GSC gives you under
# "Add property → HTML tag". This auto-renders <meta name=
# "google-site-verification" content="..."> in <head>.
GOOGLE_SITE_VERIFICATION=

# Optional — other crawlers that use the same meta-tag verification pattern.
AHREFS_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=

# ── Google AdSense ─────────────────────────────────────────
# Set this after AdSense approves the domain. Format: ca-pub-XXXXXXXXXXXXXXXX.
# When non-empty, /components/seo/GoogleAdSense.tsx mounts the publisher
# script on every page (required by AdSense). Also update public/ads.txt
# with the lines AdSense gives you under Authorized sellers.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=

# ── PageSpeed Insights API (admin perf audit) ──────────────
# Anonymous usage works for ad-hoc scans; set a key for higher quotas
# (free tier is generous). Get one at:
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Cron jobs ──────────────────────────────────────────────
# Shared secret for all /api/cron/* endpoints (auto-match-daily,
# auto-followup, seo-generate). Generate with: openssl rand -hex 32
CRON_SECRET=

# ── AI automation (auto-reply / daily digest / 3-day followup) ─
# Where the admin digest + per-lead notifications are sent. Defaults
# to animesh@freedomwithai.com if blank.
ADMIN_NOTIFY_EMAIL=

# ── Auto-deploy webhook (must match VPS .env.local) ────────
DEPLOY_WEBHOOK_TOKEN=
